DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 公网 IP + HTTP 临时验收时保持 0；域名 HTTPS 生效后必须改为 1。
ZHIYUQIAO_SECURE_COOKIES=0
ZHIYUQIAO_SESSION_TTL_DAYS=7

# Web listen config
APP_SERVER_NAME=127.0.0.1
APP_SERVER_PORT=7860

# Optional: set this only when you deploy under a subpath, such as /zhiyuqiao
# APP_ROOT_PATH=/zhiyuqiao

# Recommended in production:
# DATABASE_URL=postgresql+psycopg://zhiyuqiao:password@127.0.0.1:5432/zhiyuqiao
